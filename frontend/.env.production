# Production environment variables
REACT_APP_API_URL=https://herbalism-backend-130514813450.asia-east1.run.app
REACT_APP_SOCKET_URL=https://herbalism-backend-130514813450.asia-east1.run.app

# Firebase config
# ⚠️ 真值請從 Hurricane Vault 取得（路徑 hurricanedigital/dev/firebase-*）
# 或由 CI 環境變數注入，不得硬寫在此檔中。
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id
REACT_APP_E2E=

# LIDS SSO 設定（Phase 2a：hd-portal-199，生產 .199 閘道）
# ⚠️ 暫關：http :8090 下 PKCE 需 crypto.subtle（不安全脈絡不支援）+ LIDS server issuer 待修。
# Phase 3 改 https://:8443 閘道 + LIDS server issuer 修好後再開啟。詳見 docs/adr/cross-game-sso.md。
REACT_APP_LIDS_ENABLED=false
REACT_APP_LIDS_ISSUER=http://192.168.50.199:8073
REACT_APP_LIDS_CLIENT_ID=hd-portal-199
REACT_APP_LIDS_REDIRECT_URI=https://192.168.50.199:8443/herbalism/callback
