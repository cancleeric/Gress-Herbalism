# 前端環境變數範本
# 複製此檔案為 .env 並修改設定

# 後端 API URL
REACT_APP_API_URL=http://localhost:3001

# 後端 Socket.io URL
REACT_APP_SOCKET_URL=http://localhost:3001

# 使用 ngrok 時，將上述 URL 改為 ngrok 產生的公開 URL
# 範例:
# REACT_APP_API_URL=https://xxxx-xxx.ngrok.io
# REACT_APP_SOCKET_URL=https://xxxx-xxx.ngrok.io

# ── LIDS SSO 設定（Phase 1 骨架，Phase 2 填入真值） ────────────────────────
# ⛔ 無 client_secret（public client，不需要 secret）
# 所有值待 Kay（HurricaneTech）建立 herbalism OIDC client 後填入

# LIDS 啟用開關（Phase 1 預設 false，Kay 完成 client 建立後改為 true）
REACT_APP_LIDS_ENABLED=false

# LIDS issuer URL（Headscale tailnet IP，與 antique-master-web 部署慣例一致）
REACT_APP_LIDS_ISSUER=

# LIDS public client ID（由 Kay 建立後提供）
REACT_APP_LIDS_CLIENT_ID=

# LIDS redirect URI（需在 LIDS client 白名單中）
REACT_APP_LIDS_REDIRECT_URI=
