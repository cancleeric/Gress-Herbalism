# 前端環境變數範本
# 複製此檔案為 .env 並修改設定

# 後端 API URL
REACT_APP_API_URL=http://localhost:3001

# 後端 Socket.io URL
REACT_APP_SOCKET_URL=http://localhost:3001

# 使用 ngrok 時，將上述 URL 改為 ngrok 產生的公開 URL
# 範例:
# REACT_APP_API_URL=https://xxxx-xxx.ngrok.io
# REACT_APP_SOCKET_URL=https://xxxx-xxx.ngrok.io

# ── Firebase 設定（必填，缺少即 build/啟動失敗）────────────────────────────
# 真值來源：Hurricane Vault（路徑 hurricanedigital/dev/firebase-*）
# 或由 CI 環境變數注入（build time）。
# ⛔ 不得在程式或 tracked 設定檔中硬寫真值。
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id

# ── LIDS SSO 設定（Phase 1 骨架，Phase 2 填入真值） ────────────────────────
# ⛔ 無 client_secret（public client，不需要 secret）
# 所有值待 Kay（HurricaneTech）建立 herbalism OIDC client 後填入

# LIDS 啟用開關（Phase 2a 已啟用，生產填 true）
REACT_APP_LIDS_ENABLED=false

# LIDS issuer URL（.199 LIDS server）
# 生產：http://192.168.50.199:8073
REACT_APP_LIDS_ISSUER=http://192.168.50.199:8073

# LIDS public client ID（Phase 2a client：hd-portal-199，Public + PKCE）
REACT_APP_LIDS_CLIENT_ID=hd-portal-199

# LIDS redirect URI（需在 LIDS client 白名單中）
# 生產：http://192.168.50.199:8090/herbalism/callback
# 本機：http://localhost:3000/herbalism/callback
REACT_APP_LIDS_REDIRECT_URI=http://localhost:3000/herbalism/callback
