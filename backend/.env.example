# 後端伺服器環境變數範本
# 複製此檔案為 .env 並修改設定

# 伺服器埠號
PORT=3001

# 允許的來源網域（以逗號分隔）
# 開發環境設為空或不設定即允許所有來源
# 生產環境建議指定允許的網域
# 範例: ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Firebase 專案 ID（P1 安全修復：用於驗證 Firebase ID token）
# 從 Firebase Console > 專案設定 > 一般 取得
# ⛔ 不填寫此值，所有需要身份驗證的 API 將回傳 503
FIREBASE_PROJECT_ID=
