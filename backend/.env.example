# 後端伺服器環境變數範本
# 複製此檔案為 .env 並修改設定

# 伺服器埠號
PORT=3001

# 允許的來源網域（以逗號分隔）
# 開發環境設為空或不設定即允許所有來源
# 生產環境建議指定允許的網域
# 範例: ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Firebase 專案 ID（P1 安全修復：用於驗證 Firebase ID token）
# 從 Firebase Console > 專案設定 > 一般 取得。
# 此值為公開的 Firebase project id，非 secret，可安全寫入此範本。
# ⛔ 不填寫此值，所有需要身份驗證的 API 將回傳 503
#
# 本草遊戲的 Firebase project id：gress-6270d
#
# 注入方式（.199 容器部署，三選一）：
#
# 方式 A — docker-compose.yml 的 environment 區塊：
#   services:
#     herbalism-backend-dev:
#       environment:
#         - FIREBASE_PROJECT_ID=gress-6270d
#
# 方式 B — docker-compose.yml 使用 env_file：
#   services:
#     herbalism-backend-dev:
#       env_file:
#         - .env           # 將 FIREBASE_PROJECT_ID=gress-6270d 寫入 .env
#
# 方式 C — docker run 直接 -e 注入：
#   docker run -e FIREBASE_PROJECT_ID=gress-6270d ...
#
# 驗證注入是否成功（curl 應回 200，非 503）：
#   curl http://localhost:3001/api/health
#   # 若 /api/players/sync 等受 verifyAuth 保護的端點回 503 → 表示 env 未注入
FIREBASE_PROJECT_ID=gress-6270d

# ── Supabase 設定（必填，缺少即啟動失敗）─────────────────────────────────────
# 真值來源：Hurricane Vault（路徑 hurricanedigital/dev/supabase-*）
# ⛔ 不得在程式或 tracked 設定檔中硬寫真值（anon key 屬 secret，不可 commit）。
#
# SUPABASE_URL     — Supabase 專案 URL（格式：https://<ref>.supabase.co）
# SUPABASE_ANON_KEY — Supabase anon key（JWT，從 Supabase Console > Settings > API 取得）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
